{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feed.vakter.app/schema/categories/sources.schema.json",
  "title": "Vakter threat-feed — sources.json",
  "description": "Per-category source attribution. The only bundle file whose top-level is an object, not a bare array, to prevent generic array-readers from treating it as data. Canonical spec: openspec/changes/vakter-watch-pivot/specs/threat-feed/bundle-schema.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/Source" }
    }
  },
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "license", "categories", "fetched_at"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique across the file. Foreign key target for source_id in pattern files."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable source name (e.g. 'PhishTank')."
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "enum": [
            "open-data",
            "CC0",
            "CC-BY",
            "CC-BY-SA",
            "public-domain",
            "vakter-curated",
            "proprietary-with-permission"
          ]
        },
        "permission_note": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED when license is proprietary-with-permission. Build-time hard fail otherwise."
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "phishing-domains",
              "phone-numbers",
              "apple-support-fakes",
              "malware-bundle-ids",
              "sms-templates",
              "romance-scam-patterns",
              "package-scam-templates"
            ]
          },
          "description": "Which of the 7 indicator categories this source contributed to. (sources is not listed because a source can't attribute itself.)"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 UTC. When the publisher last pulled this source."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "license": { "const": "proprietary-with-permission" } },
            "required": ["license"]
          },
          "then": {
            "required": ["permission_note"]
          }
        }
      ]
    }
  }
}
