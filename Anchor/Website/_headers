# Vakter — vakter.app
# Cloudflare Pages / Netlify _headers
#
# Syntax: each block starts with a URL pattern on its own line, followed by
# one or more "  Header-Name: value" lines (two-space indent).
# Cloudflare Pages docs: https://developers.cloudflare.com/pages/configuration/headers/
# Netlify docs:          https://docs.netlify.com/routing/headers/
#
# ─── Security headers — applied to every response ─────────────────────────────
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# ─── Cache: HTML pages — always revalidate ────────────────────────────────────
# HTML is unfingerprinted; we want instant propagation on every deploy.
/*.html
  Cache-Control: no-cache

# ─── Cache: fingerprinted assets — immutable for one year ─────────────────────
# Images, CSS, JS, fonts, video under /assets/ are content-addressed
# (or should be when a build pipeline is added). Treat as immutable.
# If an asset changes, give it a new filename / query string.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ─────────────────────────────────────────────────────────────────────────────
# Content-Security-Policy — NOT applied in this sprint.
#
# The site uses `<style>` blocks inline and CSS custom properties set inline
# on elements. A strict CSP would require 'unsafe-inline' for styles or a
# nonce/hash per block, which is out of scope for the initial deploy.
#
# When ready, a starting-point CSP for this site (system-fonts-only,
# no third-party scripts, no external CDNs, self-origin media):
#
#   Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
#
# Before enabling: audit every <style>, inline style="", and the two
# <script> blocks in index.html and concepts/index.html. Replace inline
# script blocks with external .js files under /assets/js/ so they can be
# covered by 'self' without 'unsafe-inline' on script-src.
# Track as a follow-up security hardening task.
