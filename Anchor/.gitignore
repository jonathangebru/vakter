# SPM / Xcode
Package.resolved
.swiftpm/

# xcodegen-generated artefacts. `iOS/project.yml` is the source of truth;
# every dev regenerates these locally via `cd iOS && xcodegen generate`.
# Committing them would invite drift between project.yml and the
# materialised plists/projects. The watchOS Info.plist sits under
# WatchOS/VakterWatch/ because xcodegen writes it next to the sources
# (the project.yml `info.path` is relative to the xcodegen .yml location).
iOS/VakterCompanion.xcodeproj/
iOS/VakterCompanion/Info.plist
iOS/VakterCompanion/VakterCompanion.entitlements
WatchOS/VakterWatch/Info.plist

# Notarisation artefacts
*.zip

# Local config
*.local
.env
.env.local

# macOS
.DS_Store

# Logs
*.log

# Piper voice rendering workspace — dev-machine only. The ONNX models
# (~500 MB) and the Python venv are byproducts of `Scripts/render-voices.sh`
# and get downloaded fresh on each dev's machine. The RENDERED audio
# under `Sources/VakterApp/Resources/voices/` IS tracked because that's
# what ships in the .app bundle.
voices/models/
voices/piper-venv/

# AI team — operational logs are per-machine, don't track
.claude/dispatcher-log.md
.claude/strategy/idle-log.md
