<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime is required for notarisation. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>

    <key>com.apple.security.cs.allow-jit</key>
    <false/>

    <!-- Camera + audio + Bluetooth used directly by Anchor. -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <key>com.apple.security.device.audio-input</key>
    <true/>

    <key>com.apple.security.device.bluetooth</key>
    <true/>

    <!-- App-Sandbox is intentionally OFF — sandbox blocks the IOKit/CoreAudio
         access we need. Direct-distributed apps don't require it. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- XPC mach service the helper exposes; we're allowed to talk to it. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>app.anchor.mac.shared</string>
    </array>
</dict>
</plist>
