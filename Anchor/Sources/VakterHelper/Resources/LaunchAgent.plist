<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- LaunchAgent that runs the Vakter helper for the logged-in user.
         Loaded via SMAppService.agent from the menubar app on first run. -->

    <key>Label</key>
    <string>app.vakter.mac.helper</string>

    <!-- Path relative to the .app bundle. Build-app.sh renames the
         binary from the SwiftPM product name (VakterHelper) to
         VakterHelper on copy. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/VakterHelper</string>

    <key>MachServices</key>
    <dict>
        <key>app.vakter.mac.helper.xpc</key>
        <true/>
    </dict>

    <!-- Keep alive across launchd-detected crashes. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/tmp/vakter-helper.err.log</string>

    <key>StandardOutPath</key>
    <string>/tmp/vakter-helper.out.log</string>
</dict>
</plist>
