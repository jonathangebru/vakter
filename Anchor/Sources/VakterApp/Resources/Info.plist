<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleDisplayName</key>
    <string>Vakter</string>

    <!-- CFBundleExecutable must match the actual binary filename inside
         Contents/MacOS/. We rename the binary on copy in build-app.sh,
         so the SwiftPM build product ("VakterApp") becomes "Vakter"
         in the assembled bundle. -->
    <key>CFBundleExecutable</key>
    <string>Vakter</string>

    <key>CFBundleIdentifier</key>
    <string>app.vakter.mac</string>

    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>Vakter</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>1.4.2</string>

    <key>CFBundleVersion</key>
    <string>2</string>

    <!-- Used by MacPaw / App Store to categorise. "Utilities" is the
         right bucket for an anti-theft alarm. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>

    <!-- Surfaced in About dialogs + the Finder Get Info pane.
         Year is left forward-looking so the binary doesn't visibly
         date itself every January. -->
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Vakter. All rights reserved.</string>

    <!-- Menubar-only — no Dock icon, no main window. -->
    <key>LSUIElement</key>
    <true/>

    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Permission usage strings (shown in the macOS TCC prompts). -->
    <key>NSCameraUsageDescription</key>
    <string>Vakter uses the FaceTime camera to capture photos when the alarm fires, so you can see who tried to take your Mac.</string>

    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Vakter uses Bluetooth to sense whether your trusted devices (phone, AirPods, watch) are near, so it doesn't fire false alarms when you're present.</string>

    <key>NSAppleEventsUsageDescription</key>
    <string>Vakter uses AppleEvents to send evidence to your phone via Messages.app when the alarm fires.</string>

    <!-- Location is requested from the menubar app (where the TCC prompt
         can show) so the helper can attach a Maps URL to the iMessage
         evidence. Optional — alarm still works without it. -->
    <key>NSLocationUsageDescription</key>
    <string>Vakter attaches a Maps link to the iMessage evidence it sends to your phone when the alarm fires, so you know where your Mac was. Optional — the alarm still fires without it.</string>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Vakter attaches a Maps link to the iMessage evidence it sends to your phone when the alarm fires, so you know where your Mac was. Optional — the alarm still fires without it.</string>

    <!-- Vakter URL scheme — used by Shortcuts / future deep links. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>app.vakter.mac</string>
            <key>CFBundleURLSchemes</key>
            <array><string>vakter</string></array>
        </dict>
    </array>

    <!-- Sparkle 2 auto-update configuration.

         All Sparkle keys below are picked up by SPUStandardUpdaterController
         on launch (`UpdaterController.swift`). The matching EdDSA private key
         lives in the developer's login keychain (NOT in this repo); only
         the public key is committed here. Every downloaded update is
         verified against the public key before Sparkle's hardened-runtime
         XPC InstallerLauncher unpacks it, so a compromised mirror or
         MITM cannot push a malicious update.

         Reviewers + security-conscious buyers will inspect these values
         in the shipped .app bundle. Keep them readable. -->

    <!-- Static URL hosting the EdDSA-signed appcast.xml. Must be HTTPS —
         Sparkle 2 refuses plain http feeds. Hosted on vakter.app as part
         of the static site deploy; the file itself lives in Website/
         and ships through the same Cloudflare Pages pipeline. -->
    <key>SUFeedURL</key>
    <string>https://vakter.app/appcast.xml</string>

    <!-- Ed25519 public key (base64). The matching private key is in the
         developer's login keychain under sparkle-project.org / ed25519
         (Sparkle's `generate_keys` writes it there); see SPARKLE_SETUP.md.
         Sparkle verifies every downloaded DMG against this key before
         install — if the bytes don't match, the update is rejected.

         Placeholder value here. The first real key is generated by the
         developer running `.build/artifacts/sparkle/Sparkle/bin/generate_keys`
         once locally, then the printed public key is pasted in here and
         that commit is the one that ships in the binary. See
         SPARKLE_SETUP.md §2 for the runbook. -->
    <key>SUPublicEDKey</key>
    <string>PLACEHOLDER_PUBLIC_KEY_RUN_GENERATE_KEYS_FIRST</string>

    <!-- Background checks every 24h. Default-on; the user can flip it
         off via Settings → General → "Automatically check for updates". -->
    <key>SUEnableAutomaticChecks</key>
    <true/>

    <!-- 86400 seconds = 24 hours. Spelled explicitly so a reviewer
         doesn't have to guess what Sparkle's default is. -->
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>

    <!-- Show release notes inline in the update prompt (the
         `<description>` CDATA from the appcast item). Without this
         Sparkle just shows version + size, which gives the user
         no reason to click Install. -->
    <key>SUEnableDownloadedReleaseNotes</key>
    <true/>

    <!-- Require an explicit user click before applying. Conservative on
         purpose: a security app should never silently mutate itself
         under the user. If we ship a v1.4.x patch that fixes a
         vulnerability we'll communicate it through release notes, not
         a quiet swap. -->
    <key>SUEnableAutomaticUpdates</key>
    <false/>
</dict>
</plist>
