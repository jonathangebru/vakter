<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime is required for notarisation. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>

    <key>com.apple.security.cs.allow-jit</key>
    <false/>

    <!-- Camera + audio + Bluetooth used directly by Vakter. -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <key>com.apple.security.device.audio-input</key>
    <true/>

    <key>com.apple.security.device.bluetooth</key>
    <true/>

    <!-- App-Sandbox is intentionally OFF — sandbox blocks the IOKit/CoreAudio
         access we need. Direct-distributed apps don't require it. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- App group string for any cross-process shared-defaults use. The
         helper has the same entry; Vakter currently uses file-system stores
         (Application Support) rather than CFPreferences, so this is held
         for future use. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>app.vakter.mac.shared</string>
    </array>

    <!-- iCloud / CloudKit — powers the iPhone + Watch companion mirror.
         The container ID matches `CloudKitConstants.containerID` in
         VakterShared. CloudKitPublisher uses `EntitlementProbe` at
         runtime to gracefully degrade if the container isn't actually
         provisioned in Developer Portal yet, so the entitlement key
         being present here can't crash the app even before
         iOS/SETUP.md provisioning is finished.
         **Entitlement values mirror the Developer ID provisioning
         profile** at Contents/embedded.provisionprofile — codesign
         validates them against the profile at sign time and the kernel
         re-validates at spawn time. Mismatches → kernel refuses
         launch. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.app.vakter.shared</string>
    </array>
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Production</string>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.app.vakter.shared</string>
    </array>
</dict>
</plist>
