<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Privileged LaunchDaemon for Vakter. Loaded via
         SMAppService.daemon(plistName:) from the menubar app.
         Runs as root (UID 0). -->

    <key>Label</key>
    <string>app.vakter.mac.privileged-helper</string>

    <!-- Path relative to the .app bundle. Build-app.sh renames the
         binary from the SwiftPM product name to VakterPrivilegedDaemon
         on copy. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/VakterPrivilegedDaemon</string>

    <key>MachServices</key>
    <dict>
        <key>app.vakter.mac.privileged-helper.xpc</key>
        <true/>
    </dict>

    <!-- Loaded on demand when a client connects to the Mach service. -->
    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardErrorPath</key>
    <string>/tmp/vakter-privileged.err.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/vakter-privileged.out.log</string>
</dict>
</plist>
