<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <!-- Matches the binary filename in Contents/MacOS/ after build-app.sh
         renames the SwiftPM product. -->
    <key>CFBundleExecutable</key>
    <string>VakterPrivilegedDaemon</string>

    <key>CFBundleIdentifier</key>
    <string>app.vakter.mac.privileged-helper</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>Vakter</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSBackgroundOnly</key>
    <true/>

    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Restricts which processes are allowed to talk to our Mach service.
         Must match the code requirement check we do programmatically in
         ListenerDelegate. The clause is signature-based (Team ID), not
         bundle-ID-based, so it survives the rebrand.

         The `__TEAM_ID__` token is substituted by Scripts/build-app.sh at
         bundle-assembly time, reading the active Developer ID Application
         cert via `security find-identity -v -p codesigning`. This way the
         daemon and helper bind to whichever Team ID is doing the signing —
         the project works for any contributor's signing identity, not just
         the original author's. -->
    <key>SMAuthorizedClients</key>
    <array>
        <string>anchor apple generic and certificate leaf[subject.OU] = "__TEAM_ID__"</string>
    </array>
</dict>
</plist>
